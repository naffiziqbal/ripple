# Ripple API configuration
NODE_ENV=development
PORT=4000

# PostgreSQL connection (docker compose up -d provides this default).
# Host port is 5433 to avoid clashing with a local Postgres on 5432;
# change POSTGRES_PORT (compose) + this URL together if you need another port.
DATABASE_URL=postgres://ripple:ripple@localhost:5433/ripple

# REQUIRED in production — any long random string
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Path to your Firebase service account JSON (Project settings → Service accounts).
# If the file does not exist the API still runs; pushes are logged to stdout instead.
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# Firebase Web API key (google-services.json → client[0].api_key[0].current_key).
# Enables Firebase-backed email/password auth, account-creation emails, and
# password-reset emails. Requires Email/Password sign-in enabled in the Firebase
# console. Without it, auth falls back to local bcrypt (no emails, no reset).
FIREBASE_WEB_API_KEY=
